{
  "manifest_version": 3,
  "name": "ReferralRoute",
  "version": "1.0.0",
  "description": "LinkedIn job tracker and referral route organizer.",
  "action": {
    "default_popup": "index.html",
    "default_title": "ReferralRoute"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
